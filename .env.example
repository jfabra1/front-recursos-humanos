# URL base de la API del backend (incluye /api, sin barra final)
VITE_API_URL=http://localhost:3005/api
# Token público de Mapbox (empieza con "pk.") — https://account.mapbox.com/access-tokens/
# Usado solo para el mapa interactivo de ubicación de Sedes (SedesVista.vue), cargado bajo
# demanda (solo al abrir el modal de crear/editar), nunca en listados.
VITE_MAPBOX_TOKEN=pk.tu_token_publico_aqui
